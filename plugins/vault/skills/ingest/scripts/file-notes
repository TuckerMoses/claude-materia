#!/usr/bin/env python3
"""The vault's note bookkeeping. Called by dispatch-targets, which runs the ordering between these steps; the note
itself is written by the `notes` adapter (adapters/notes).

  file-notes lookup VAULT MANIFEST   -> {ref: {slug, labels, outcome} | {failed}} for thoughts already filed
  file-notes check VAULT MANIFEST    -> {checked: true}, or exit 1: a path out of bounds or an empty body
  file-notes rewrite VAULT PLAN      -> {rewritten: [...], failed: [{slug, reason}]}
  file-notes finish VAULT PLAN       -> markers, then watermarks, then moves; writes report.json; prints it

Exit 1 with `ABORT ...` on an iron-rule or bounds refusal; nothing after it runs.
"""
import json
import sys
from pathlib import Path

import _file_notes as fn

COMMANDS = {'lookup': fn.lookup, 'check': fn.check, 'rewrite': fn.rewrite, 'finish': fn.finish}


def main():
    if len(sys.argv) != 4 or sys.argv[1] not in COMMANDS:
        sys.exit('usage: file-notes lookup|check|rewrite|finish VAULT_PATH JSON_FILE')
    vault = Path(sys.argv[2]).expanduser()
    if not (vault / 'notes').is_dir():
        sys.exit(f'vault not found (no notes/ under {vault})')
    data = json.loads(Path(sys.argv[3]).read_text(encoding='utf-8'))
    try:
        print(json.dumps(COMMANDS[sys.argv[1]](vault, data), indent=2))
    except fn.Abort as e:
        sys.exit(f'ABORT {e}')


if __name__ == '__main__':
    main()
