#!/usr/bin/env python3
"""One-off (Capture to Week, One-time 7): turn an Apple Notes CSV export into dated journal day-files. Remove after use.

Usage: notes-csv-to-days VAULT CSV --date-column NAME --body-column NAME [--title-column NAME] [--apply]
Dry run by default. Rows sharing a date join one day-file, oldest row first, separated by a blank line. A row already in
that day-file is skipped, so a rerun adds nothing. A day-file marked ingested is refused: its new text would never drain.

Unload the nightly job before --apply and run ingest interactively after, so a person reviews these at the gate.
"""
import argparse
import collections
import csv
import datetime
import re
import sys
from pathlib import Path

FORMATS = ('%Y-%m-%d', '%Y-%m-%d %H:%M:%S', '%Y-%m-%dT%H:%M:%S', '%m/%d/%Y', '%m/%d/%y', '%m/%d/%Y %H:%M', '%m/%d/%y %H:%M', '%B %d, %Y', '%b %d, %Y')


def parse_date(value):
    text = value.strip()
    text = re.sub(r'(\.\d+)?(Z|[+-]\d{2}:?\d{2})$', '', text)
    for fmt in FORMATS:
        try:
            return datetime.datetime.strptime(text, fmt).date()
        except ValueError:
            pass
    return None


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('vault')
    p.add_argument('csv')
    p.add_argument('--date-column', required=True)
    p.add_argument('--body-column', required=True)
    p.add_argument('--title-column')
    p.add_argument('--apply', action='store_true')
    args = p.parse_args()
    journal = Path(args.vault).expanduser() / 'journal'
    if not journal.is_dir():
        sys.exit(f'vault not found (no journal/ under {args.vault})')
    with open(args.csv, encoding='utf-8-sig', newline='') as f:
        reader = csv.DictReader(f)
        needed = [c for c in (args.date_column, args.body_column, args.title_column) if c]
        missing = [c for c in needed if c not in (reader.fieldnames or [])]
        if missing:
            sys.exit(f'no column {missing}; columns are {reader.fieldnames}')
        rows = list(reader)

    today = datetime.date.today()
    days, problems = collections.defaultdict(list), []
    for number, row in enumerate(rows, 2):
        date = parse_date(row.get(args.date_column) or '')
        body = (row.get(args.body_column) or '').strip('\n')
        title = (row.get(args.title_column) or '').strip() if args.title_column else ''
        if not body.strip() and not title:
            continue
        if date is None:
            problems.append(f'row {number}: cannot read date {row.get(args.date_column)!r}')
        elif date >= today:
            problems.append(f'row {number}: {date} is not a closed day')
        else:
            first = body.lstrip('\n').split('\n', 1)[0].strip()
            days[date].append(f'{title}\n{body}' if title and title != first else body)

    added, skipped = 0, 0
    for date in sorted(days):
        path = journal / f'{date.isoformat()}.md'
        existing = path.read_text(encoding='utf-8') if path.exists() else ''
        if re.match(r'^---\n(?:.*\n)*?ingested:\s*true\s*\n', existing):
            problems.append(f'{path.name} is already ingested; its {len(days[date])} row(s) were not added')
            continue
        new = []
        for entry in days[date]:
            if entry in existing or entry in new:
                skipped += 1
            else:
                new.append(entry)
        if not new:
            continue
        added += len(new)
        print(f'{"wrote" if args.apply else "would write"} {path.name}: {len(new)} row(s)')
        if args.apply:
            joined = '\n\n'.join(new) + '\n'
            path.write_text((existing.rstrip('\n') + '\n\n' + joined) if existing.strip() else joined, encoding='utf-8')
    print(f'{added} rows {"added" if args.apply else "to add"} to {len(days)} day(s), {skipped} already present, {len(problems)} problem(s)'
          + ('' if args.apply else '. Dry run: rerun with --apply.'))
    for line in problems:
        print(f'PROBLEM: {line}')
    sys.exit(1 if problems else 0)


if __name__ == '__main__':
    main()
