#!/usr/bin/env python3
"""Read-only vault intake health. Usage: ingest-status VAULT_PATH

The first line is `pending closed day-files: N`; the nightly wrapper reads it, so it stays first and stays in this
form. Reads only the vault and its own routing file, and only reports: an unusable note or routing file is an anomaly,
never a crash.
"""
import json, os, re, subprocess, sys, time
from pathlib import Path
import yaml

sys.path.insert(1, str(Path(__file__).resolve().parents[3] / 'scripts'))  # the plugin's shared modules
import _file_notes  # noqa: E402
import _note_frontmatter as fm  # noqa: E402
import _routing  # noqa: E402

ACTION = ('todo', 'session-seed', 'delegated')  # the protected action labels (spec D8)

DAY = re.compile(r'^\d{4}-\d{2}-\d{2}\.md$')

def registered_sources(data):
    """Registry entries usable by a reader. A malformed one is reported and skipped, never fatal."""
    sources = data.get('sources') or []
    if not isinstance(sources, list):
        print('malformed registry: sources is not a list')
        return []
    good = []
    for s in sources:
        if isinstance(s, dict) and isinstance(s.get('path'), str) and s.get('track') in ('vcs', 'destructive'):
            good.append(s)
        else:
            print(f'malformed registry entry: {s}')
    return good


# Every child call is bounded (Nightly job: fail loud, never hang).
CALL_TIMEOUT = int(os.environ.get('VAULT_INGEST_CALL_TIMEOUT', '300'))


def main():
    if len(sys.argv) != 2:
        sys.exit('usage: ingest-status VAULT_PATH')
    vault = Path(sys.argv[1]).expanduser()
    if not (vault / 'journal').is_dir():
        sys.exit(f'vault not found (no journal/ under {vault})')
    here = Path(__file__).resolve().parent
    try:  # F11: bounded, no stdin, and a timeout is reported rather than raised
        cand = json.loads(subprocess.run(
            [sys.executable, str(here / 'journal-candidates'), str(vault)],
            stdin=subprocess.DEVNULL, capture_output=True, text=True, check=True, timeout=CALL_TIMEOUT).stdout)
    except subprocess.TimeoutExpired:
        sys.exit(f'journal-candidates timed out after {CALL_TIMEOUT}s')
    print(f"pending closed day-files: {len(cand['closed'])}"
          + (f" ({', '.join(p.split('/')[-1] for p in cand['closed'])})" if cand['closed'] else ''))
    data = yaml.safe_load((vault / '_machine' / 'ingest_paths.yml').read_text(encoding='utf-8')) or {}
    for s in registered_sources(data):
        if s['track'] == 'vcs' and s.get('last_read'):
            try:
                n = subprocess.run(['git', 'rev-list', '--count', f"{s['last_read']}..HEAD"],
                                   cwd=Path(s['path']).expanduser(), stdin=subprocess.DEVNULL, capture_output=True,
                                   text=True, env=dict(os.environ, GIT_TERMINAL_PROMPT='0'),
                                   timeout=CALL_TIMEOUT).stdout.strip()
            except subprocess.TimeoutExpired:
                n = 'timed out:'
            print(f"source {s['path']}: {n or '?'} commit(s) pending")
        else:
            print(f"source {s['path']}: destructive (drain to consume)")
    notes, bad = read_notes(vault)
    print(f'needs-label: {sum(1 for _, data in notes if "needs-label" in labels_of(data))}')
    squat = [p.name for p in (vault / 'journal').iterdir() if p.suffix == '.md' and not DAY.match(p.name)]
    if squat:
        print(f'{len(squat)} non-day-file note(s) in journal/ — relocate to notes/ (manual refactor): '
              + ', '.join(sorted(squat)[:5]) + ('…' if len(squat) > 5 else ''))
    logs = vault / '_machine' / 'logs' / 'ingest'
    flagged = []
    if logs.is_dir():
        for run in logs.iterdir():
            rj = run / 'run.json'
            if not rj.is_file():
                continue
            info = json.loads(rj.read_text(encoding='utf-8'))
            ts = info.get('ts', 0)
            if not isinstance(ts, (int, float)):
                continue  # malformed run.json — skip rather than traceback
            for rel in info.get('marked', []):
                p = vault / rel
                if p.is_file() and p.stat().st_mtime > ts + 60:
                    flagged.append(rel)
    if flagged:
        print('modified AFTER ingest (late sync?): ' + ', '.join(sorted(set(flagged)))
              + ' — remove the marker and re-drain (idempotent, duplicate-free)')
    elif not logs.is_dir():
        print('(no run logs yet — modified-after-ingest detection starts with the first drain)')
    held_and_warnings(vault)
    reconcile(vault, notes, bad)

def run_key(run_dir):
    m = re.match(r'^(\d{4}-\d{2}-\d{2})-(\d+)$', run_dir.name)
    return (m.group(1), int(m.group(2))) if m else ('', 0)


def reports(vault):
    """(run dir, report, run.json) for each run with a readable report, oldest first."""
    logs = vault / '_machine' / 'logs' / 'ingest'
    out = []
    for run in sorted((d for d in logs.iterdir() if d.is_dir()), key=run_key) if logs.is_dir() else []:
        try:
            report = json.loads((run / 'report.json').read_text(encoding='utf-8'))
        except (OSError, ValueError):
            continue
        try:
            info = json.loads((run / 'run.json').read_text(encoding='utf-8'))
        except (OSError, ValueError):
            info = {}
        out.append((run, report, info))
    return out


def age(info):
    ts = info.get('ts')
    return f'{int((time.time() - ts) / 86400)}d' if isinstance(ts, (int, float)) else '?'


def show(title, lines, limit=10):
    if lines:
        print(f'{title}: {len(lines)}')
        for line in lines[:limit]:
            print(f'  {line}')
        if len(lines) > limit:
            print(f'  ... and {len(lines) - limit} more')


def held_and_warnings(vault):
    """Held units from the newest report entries, while still un-ingested; warnings from the five newest runs."""
    runs = reports(vault)
    held = {}
    for run, report, info in runs:
        for unit in report.get('marked', []):
            held.pop(unit, None)
        for h in report.get('held') or []:
            held[h.get('day_file') or h.get('source', '?')] = (run.name, h.get('failed', []), info)
    lines = []
    for unit, (run, failed, info) in sorted(held.items()):
        for f in failed:
            target = f.get('target') or {}
            keys = ('target', 'adapter') if 'target' in target else ('container', 'name', 'artifact')
            where = '/'.join(str(target[k]) for k in keys if target.get(k))
            lines.append(f'{unit} ({age(info)} old, run {run}): {where or "no target"}: {f.get("reason")}')
    show('held', lines)
    warnings = [f'{run.name}: {w.get("title", w.get("ref"))}: {w.get("message")}' for run, report, _ in runs[-5:]
                for w in report.get('warnings') or []]
    show('routing warnings (5 newest runs)', warnings)


def read_notes(vault):
    """(notes with frontmatter, anomalies). An unparseable note is reported and skipped, never fatal."""
    notes, bad = [], []
    for p in sorted((vault / 'notes').glob('*.md')):
        try:
            notes.append((p.stem, fm.parse(fm.read_text(p))))
        except (fm.NoteError, OSError, UnicodeDecodeError) as e:
            bad.append(f'{p.name}: {e}')
    return notes, bad


def labels_of(data):
    labels = data.get('labels')
    return [x for x in labels if isinstance(x, str)] if isinstance(labels, list) else []


def undelivered(notes):
    """Open actionables no external target has delivered: an action label, no outcome, and nothing in routed_to but
    the vault copy. With only the notes target routed, that is every open actionable."""
    out = []
    for slug, data in notes:
        routed = data.get('routed_to') if isinstance(data.get('routed_to'), list) else []
        if any(x in ACTION for x in labels_of(data)) and not data.get('outcome') and not data.get('handled') \
                and not any(_file_notes.is_external(t) for t in routed):
            out.append(slug)
    return out


def lens_violations(vault):
    """The loop guard: a lens label that some rule would deliver outside the vault."""
    try:
        routing = _routing.load(vault)
    except _routing.RoutingError as e:
        print(f'loop guard not checked: {e}')
        return []
    registry = yaml.safe_load((vault / '_machine' / 'ingest_paths.yml').read_text(encoding='utf-8')) or {}
    found = []
    with open(os.devnull, 'w') as quiet:  # main already reported malformed entries
        stdout, sys.stdout = sys.stdout, quiet
        try:
            sources = registered_sources(registry)
        finally:
            sys.stdout = stdout
    for s in sources:
        lens = s.get('lens') or []
        if not isinstance(lens, list) or not all(isinstance(x, str) for x in lens):
            found.append(f'{s["path"]}: lens is not a list of labels, so it cannot be checked')
            continue
        found += [f'{s["path"]}: lens label {label} is outbound' for label in lens if routing.is_outbound(label)]
    return found


def reconcile(vault, notes, bad):
    show('unparseable notes', bad)
    open_items = undelivered(notes)
    print(f'undelivered actionables: {len(open_items)}'
          + (' (no external target holds them; note-outcome VAULT SLUG done|dropped closes one)' if open_items else ''))
    for slug in open_items[:10]:
        print(f'  {slug}')
    if len(open_items) > 10:
        print(f'  ... and {len(open_items) - 10} more')
    show('lens contains an outbound label', lens_violations(vault))


if __name__ == '__main__':
    main()
