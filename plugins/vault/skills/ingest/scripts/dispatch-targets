#!/usr/bin/env python3
"""Route thoughts, deliver them through their targets' adapters in order, and record what happened. Names no label
and no target.

  dispatch-targets route VAULT MANIFEST
      For the gate. Per thought: the labels to propose (a filed note's stored labels win, invariant 5) and the targets
      those labels route to under <vault>/_machine/routing.yml. Writes nothing.

  dispatch-targets run VAULT MANIFEST --mode silent|interactive [--no-journal] [--recovered RUN_ID]
      Deliver to the notes target, whose result is the thought's id, then to the others in order; then routed_to;
      then, for fully successful units only, markers, watermarks and moves; then report.json beside the manifest.
      Exits 0 even with held units: commit-run must still run, and it is what exits non-zero on held. Exits non-zero
      only if the run failed before its commit points.

Routing is data: <vault>/_machine/routing.yml declares targets (each naming the adapter that delivers to it, and its
params) and rules (label match -> target names). An adapter is an executable in adapters/ beside this script; see
adapters/notes for the interface. A routing file that is absent, fails its schema, or names an adapter that does not
exist fails the run before anything is written.

--no-journal is for a run scoped to one external source, whose closed day-files are not this run's business.
--recovered records the interrupted run that `commit-run --recover` committed as this run's first action.
Every child call times out after $VAULT_INGEST_CALL_TIMEOUT seconds (default 300): a timed-out adapter is a failed
target, so its unit is held; any other timed-out call aborts the run before markers, as any failure there does.
$VAULT_INGEST_RUN_DEADLINE (seconds, unset = none; the nightly sets it) bounds the adapter calls' sum, whose count grows
with the thoughts: each adapter call gets what is left, and one past it times out at once, so its unit is held. The
other calls are a fixed handful (check, lookup, rewrite, journal-candidates, finish), so this whole command is bounded
by the deadline plus five call timeouts, and a caller can bound it, as the nightly does with claude's Bash timeout.
SIGTERM or SIGHUP kills the running child's process group before exiting: adapters run in their own sessions and
would outlive this process.
"""
import argparse
import datetime
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

import yaml

HERE = Path(__file__).resolve().parent
sys.path.insert(1, str(HERE.parents[2] / 'scripts'))  # the plugin's shared modules
import _ingest_keys  # noqa: E402
import _routing  # noqa: E402

ADAPTERS = HERE / 'adapters'
ABORT = 2  # an adapter's exit status meaning the run must stop
DAY_SOURCE = re.compile(r'^journal/(\d{4}-\d{2}-\d{2})$')
DIARY = ('diary', 'diary-only', 'diary_only')


def die(reason):
    sys.exit(' '.join(str(reason).split()))


# Every call on the unattended path is bounded (spec, Nightly job: fail loud, never hang). A child that blocks, as one
# did on a TCC prompt, is killed with its whole process group, so a grandchild cannot hold the pipes open.
CALL_TIMEOUT = int(os.environ.get('VAULT_INGEST_CALL_TIMEOUT', '300'))
RUN_DEADLINE = float(os.environ.get('VAULT_INGEST_RUN_DEADLINE') or 'inf')
STARTED = time.monotonic()
TIMED_OUT = 124
child = None  # the running call, for the signal handler


def kill_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def on_signal(signum, _frame):
    if child is not None:
        kill_group(child)
    sys.exit(128 + signum)


def call(argv, stdin=None, writer=False):
    global child
    name = os.path.basename(argv[0])
    budget = min(CALL_TIMEOUT, RUN_DEADLINE - (time.monotonic() - STARTED)) if writer else CALL_TIMEOUT
    if budget <= 0:
        return subprocess.CompletedProcess(argv, TIMED_OUT, '', f'timed out: the run deadline of {RUN_DEADLINE:g}s passed before {name}')
    proc = child = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    text=True, start_new_session=True)
    try:
        out, err = proc.communicate(stdin, timeout=budget)
    except subprocess.TimeoutExpired:
        kill_group(proc)
        try:
            proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:  # a descendant that left the group still holds the pipes
            pass
        return subprocess.CompletedProcess(argv, TIMED_OUT, '', f'timed out after {budget:g}s: {name}')
    finally:
        child = None
    return subprocess.CompletedProcess(argv, proc.returncode, out, err)


def file_notes(command, vault, payload):
    """Run one file-notes step on a temp JSON file. A failure here is an iron-rule abort: it stops the run."""
    with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False) as f:
        json.dump(payload, f)
    try:
        r = call([str(HERE / 'file-notes'), command, str(vault), f.name])
    finally:
        os.unlink(f.name)
    if r.returncode != 0:
        die(r.stderr or f'file-notes {command} failed')
    return json.loads(r.stdout)


def thoughts_of(manifest):
    """The manifest's thoughts with their refs, one per ref. A retry's split decides these, never a stored route."""
    seen, out = set(), []
    for n in manifest.get('notes', []):
        if n.get('disposition') in DIARY:
            continue
        ref = _ingest_keys.thought_ref(n['source'], n['body'])
        if ref not in seen:
            seen.add(ref)
            out.append(dict(n, ref=ref))
    return out


def load_routing(vault):
    """The vault's routing, with every adapter it names present. Any problem fails the run before a write."""
    try:
        routing = _routing.load(vault)
    except _routing.RoutingError as e:
        die(f'{e}; nothing written')
    for name in routing.targets:
        path = ADAPTERS / routing.adapter(name)
        if not (path.is_file() and os.access(str(path), os.X_OK)):
            die(f'target {name}: no adapter {routing.adapter(name)}; nothing written')
    return routing


def plain(routing, target):
    return {'target': target, 'adapter': routing.adapter(target)}


def proposed_labels(thought, stored):
    found = stored.get(thought['ref'])
    return found['labels'] if found and 'labels' in found else thought['labels']


def cmd_route(vault, manifest):
    thoughts = thoughts_of(manifest)
    routing = load_routing(vault)
    stored = file_notes('lookup', vault, {'notes': thoughts})
    out = []
    for t in thoughts:
        labels = proposed_labels(t, stored)
        out.append({'ref': t['ref'], 'labels': labels, 'targets': [plain(routing, x) for x in routing.route(labels)],
                    'already_filed': t['ref'] in stored, 'failed': stored.get(t['ref'], {}).get('failed')})
    print(json.dumps(out, indent=2))


def unit_of(source):
    """A journal thought's day-file, or None for an external source."""
    match = DAY_SOURCE.match(source)
    return f'journal/{match.group(1)}.md' if match else None


def is_open_day(unit):
    return unit is not None and Path(unit).stem >= datetime.date.today().isoformat()


class Run:
    def __init__(self, vault, manifest_path, mode, include_journal, recovered=None):
        self.recovered = recovered
        self.vault, self.manifest_path, self.mode = vault, manifest_path, mode
        self.include_journal = include_journal
        with open(manifest_path, encoding='utf-8') as f:
            self.manifest = json.load(f)
        self.thoughts = thoughts_of(self.manifest)
        self.failed = {}     # ref -> [{ref, id?, target, reason}]
        self.success = {}    # ref -> [targets]
        self.ids = {}        # ref -> id: the slug the notes target landed
        self.outcome = {}    # ref -> outcome stored on the note
        self.written, self.skipped, self.warnings = [], [], []

    def fail(self, thought, target, reason):
        entry = {'ref': thought['ref'], 'target': target, 'reason': ' '.join(str(reason).split())}
        if thought['ref'] in self.ids:
            entry['id'] = self.ids[thought['ref']]
        self.failed.setdefault(thought['ref'], []).append(entry)

    def ok(self, thought, target):
        self.success.setdefault(thought['ref'], []).append(target)

    def confirm_labels(self, stored):
        """Under --silent a filed note's stored labels stand. At a gate, the confirmed labels may differ."""
        self.changed = {}
        for t in self.thoughts:
            found = stored.get(t['ref'])
            if not found or 'labels' not in found:
                continue
            if self.mode == 'silent':
                t['labels'] = found['labels']
            elif t['labels'] != found['labels']:
                self.changed[t['ref']] = t['labels']

    def record_routes(self, routes):
        """A thought no rule matched is a failed target: nothing is dropped."""
        for t in self.thoughts:
            if not routes[t['ref']]:
                self.fail(t, {}, 'no routing rule matched this thought')

    def deliver(self, t, target, record):
        """One adapter call: the parsed result, or a failed result. An adapter's ABORT stops the run."""
        request = {'target': target, 'params': self.routing.params(target), 'thought': record}
        r = call([str(ADAPTERS / self.routing.adapter(target)), str(self.vault)], stdin=json.dumps(request), writer=True)
        if r.returncode == ABORT:
            die(r.stderr or f'adapter {self.routing.adapter(target)} aborted the run')
        if r.returncode != 0:
            return {'status': 'failed', 'reason': r.stderr or f'adapter {self.routing.adapter(target)} exited {r.returncode}'}
        try:
            result = json.loads(r.stdout)
        except ValueError:
            result = None
        if not isinstance(result, dict) or result.get('status') not in ('delivered', 'failed'):
            return {'status': 'failed', 'reason': f'adapter {self.routing.adapter(target)} returned no status'}
        if result['status'] == 'failed':
            result['reason'] = result.get('reason') or 'no reason given'
        return result

    def record_of(self, t):
        record = {k: v for k, v in t.items() if k not in ('ref', 'disposition', 'near_miss')}
        record['ref'] = t['ref']
        if t['ref'] in self.ids:
            record['id'] = self.ids[t['ref']]
        return record

    def deliver_notes(self, routes, stored):
        """The vault copy first. A failure, including an unusable existing note, leaves the thought's other targets
        unattempted."""
        for t in self.thoughts:
            for target in routes[t['ref']]:
                if not self.routing.is_notes(target):
                    continue
                if 'failed' in stored.get(t['ref'], {}):
                    self.fail(t, plain(self.routing, target), stored[t['ref']]['failed'])
                    continue
                result = self.deliver(t, target, self.record_of(t))
                if result['status'] == 'failed':
                    self.fail(t, plain(self.routing, target), result['reason'])
                    continue
                landed = result.get('landed') or {}
                if not all(isinstance(landed.get(k), str) for k in ('slug', 'path', 'status')):
                    self.fail(t, plain(self.routing, target), 'notes adapter landed no slug')
                    continue
                self.ids[t['ref']] = landed['slug']
                self.outcome[t['ref']] = landed.get('outcome')
                self.ok(t, plain(self.routing, target))
                (self.written if landed['status'] == 'written' else self.skipped).append(landed['path'])

    def deliver_others(self, routes):
        """Then every other target, with the note's slug as the thought's id. Skipped for a note carrying an outcome:
        the item was finished while the day-file was held."""
        for t in self.thoughts:
            targets = routes[t['ref']]
            if any(self.routing.is_notes(x) for x in targets) and t['ref'] not in self.ids:
                continue  # the vault copy failed; that failure already holds the unit
            for target in targets:
                if self.routing.is_notes(target):
                    continue
                if t['ref'] not in self.ids:
                    self.fail(t, plain(self.routing, target), 'no id source: no notes target for this thought')
                    continue
                if self.outcome.get(t['ref']):
                    continue
                result = self.deliver(t, target, self.record_of(t))
                if result['status'] == 'delivered':
                    self.ok(t, plain(self.routing, target))
                else:
                    self.fail(t, plain(self.routing, target), result['reason'])

    def write_routed_to(self):
        """Step 5, first half. Only successful targets are recorded; gate-changed labels go with them."""
        slugs = {t['ref']: self.ids[t['ref']] for t in self.thoughts if t['ref'] in self.ids}
        entries = []
        for t in self.thoughts:
            if t['ref'] in slugs:
                entry = {'slug': slugs[t['ref']], 'routed_to': self.success.get(t['ref'], [])}
                if t['ref'] in self.changed:
                    entry['labels'] = self.changed[t['ref']]
                entries.append(entry)
        result = file_notes('rewrite', self.vault, {'notes': entries})
        by_slug = {slug: ref for ref, slug in slugs.items()}
        thoughts = {t['ref']: t for t in self.thoughts}
        for failure in result['failed']:
            ref = by_slug[failure['slug']]
            self.fail(thoughts[ref], {'target': 'routed_to'}, failure['reason'])
        return result['rewritten']

    def closed_candidates(self):
        r = call([str(HERE / 'journal-candidates'), str(self.vault)])
        if r.returncode != 0:
            die(f'journal-candidates failed: {r.stderr}')
        return json.loads(r.stdout)['closed']

    def settle_units(self):
        """Which units are held, and which commit points may land. The open day holds nothing and is never marked."""
        by_unit, external, open_day = {}, {}, []
        thoughts = {t['ref']: t for t in self.thoughts}
        for ref, failures in self.failed.items():
            unit = unit_of(thoughts[ref]['source'])
            if is_open_day(unit):
                open_day += failures
            elif unit:
                by_unit.setdefault(unit, []).extend(failures)
            else:
                external.setdefault(thoughts[ref]['source'], []).extend(failures)
        wanted = [u for u in self.manifest.get('mark_ingested', []) if not is_open_day(u)]
        if self.include_journal:
            for unit in self.closed_candidates():
                if unit not in wanted and unit not in by_unit:
                    by_unit[unit] = [{'target': {}, 'reason': "not accounted for by this run's manifest"}]
        held = [{'day_file': u, 'failed': f} for u, f in sorted(by_unit.items())]
        advance, moves = self.manifest.get('advance', []), self.manifest.get('archive_moves', [])
        for source, failures in sorted(external.items()):
            held.append({'source': source, 'failed': failures})
        if external:
            advance, moves = self.independent_sources(advance, moves, list(external))
        return held, open_day, [u for u in wanted if u not in by_unit], advance, moves

    def independent_sources(self, advance, moves, failed_sources):
        """Sources are independent: only a failed source's commit points wait. A thought's source names its registered
        path; a failure that names none could belong to any source, so then every source waits."""
        with open(self.vault / '_machine' / 'ingest_paths.yml', encoding='utf-8') as f:
            registry = yaml.safe_load(f) or {}
        paths = [s['path'] for s in registry.get('sources') or [] if isinstance(s, dict) and 'path' in s]
        blocked = set()
        for source in failed_sources:
            owners = [p for p in paths if p in source]
            if not owners:
                return [], []
            blocked.update(owners)
        under = lambda moved, root: str(Path(moved).expanduser()).startswith(str(Path(root).expanduser()))
        return ([a for a in advance if a['path'] not in blocked],
                [m for m in moves if not any(under(m['from'], root) for root in blocked)])

    def run(self):
        file_notes('check', self.vault, self.manifest)
        self.routing = load_routing(self.vault)
        stored = file_notes('lookup', self.vault, {'notes': self.thoughts})
        self.confirm_labels(stored)
        routes = {t['ref']: self.routing.route(t['labels']) for t in self.thoughts}
        self.record_routes(routes)
        self.deliver_notes(routes, stored)
        self.deliver_others(routes)
        rewritten = self.write_routed_to()
        held, open_day, marks, advance, moves = self.settle_units()
        routed = [{'id': self.ids[t['ref']], 'targets': self.success.get(t['ref'], []), 'labels': t['labels'],
                   'source': t['source'], 'body_md5': _ingest_keys.body_md5(t['body'])}
                  for t in self.thoughts if t['ref'] in self.ids]
        report = {'written': self.written, 'skipped': self.skipped, 'rewritten': rewritten, 'routed': routed,
                  'held': held, 'open_day_failed': open_day, 'warnings': self.warnings}
        if self.recovered:
            report['recovered'] = self.recovered
        plan = {'mark_ingested': marks, 'advance': advance, 'archive_moves': moves, 'report': report,
                'report_path': str(Path(self.manifest_path).resolve().parent / 'report.json')}
        print(json.dumps(file_notes('finish', self.vault, plan), indent=2))


def main():
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='command', required=True)
    r = sub.add_parser('route')
    r.add_argument('vault')
    r.add_argument('manifest')
    d = sub.add_parser('run')
    d.add_argument('vault')
    d.add_argument('manifest')
    d.add_argument('--mode', required=True, choices=['silent', 'interactive'])
    d.add_argument('--no-journal', action='store_true')
    d.add_argument('--recovered', metavar='RUN_ID', help='the run id commit-run --recover printed, recorded in report.json')
    args = p.parse_args()
    vault = Path(args.vault).expanduser()
    if not (vault / 'notes').is_dir():
        die(f'vault not found (no notes/ under {vault})')
    try:
        if args.command == 'route':
            with open(args.manifest, encoding='utf-8') as f:
                cmd_route(vault, json.load(f))
        else:
            Run(vault, args.manifest, args.mode, not args.no_journal, args.recovered).run()
    except (OSError, ValueError, KeyError) as e:
        die(f'{type(e).__name__}: {e}')


if __name__ == '__main__':
    main()
