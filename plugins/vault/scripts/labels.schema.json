{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vault label bank (<vault>/_machine/labels.yml)",
  "description": "The vault's label vocabulary. Written only by label-bank.",
  "type": "object",
  "required": ["labels"],
  "additionalProperties": false,
  "properties": {
    "labels": {
      "type": "object",
      "propertyNames": {"pattern": "^(?![\\s\\S]*\\n)[a-z0-9][a-z0-9/-]*(:[a-z0-9][a-z0-9_-]*)?$"},
      "additionalProperties": {"$ref": "#/definitions/label"}
    }
  },
  "definitions": {
    "label": {
      "type": "object",
      "required": ["when_to_apply", "status"],
      "additionalProperties": false,
      "properties": {
        "when_to_apply": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "status": {"enum": ["active", "retired"]},
        "protected": {"type": "boolean"},
        "origin": {"enum": ["local", "imported"], "default": "local"}
      }
    }
  }
}
