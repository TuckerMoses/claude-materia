#!/usr/bin/env python3
"""The sole writer of a vault's label bank, <vault>/_machine/labels.yml.

  label-bank add VAULT --name N --when-to-apply TEXT   new active local label
  label-bank update VAULT --name N --when-to-apply TEXT rewrite its text
  label-bank retire VAULT --name N                     status to retired; notes keep it
  label-bank rename VAULT --from A --to B              entry, every note, routing rules and source lenses
  label-bank remove VAULT --name N                     delete the entry

Imported labels (origin: imported) are read-only to every subcommand. Protected labels refuse retire, rename and
remove; their text may be updated. Every mutation validates against labels.schema.json, refuses when a file it would
write has uncommitted changes, and lands as exactly one path-scoped jj commit, or changes nothing. A mutation that
would change nothing prints {"status": "unchanged"} and commits nothing. Prints JSON on success; exits 1 with a
reason on refusal.
"""
import argparse
import json
import sys
from pathlib import Path

import _label_bank as lb
import _vault_tx as tx


class Parser(argparse.ArgumentParser):
    def error(self, message):
        sys.exit(f'label-bank: {message}')


def die(reason):
    sys.exit('label-bank: ' + ' '.join(str(reason).split()))


def committed(op, changes, message, **extra):
    tx.apply(VAULT, changes, message)
    print(json.dumps(dict({'status': 'committed', 'op': op, 'files': [c.rel for c in changes]}, **extra)))


def add(bank, a):
    if a.name in bank.labels:
        die(f'{a.name} already exists (status {bank.labels[a.name]["status"]})')
    labels = dict(bank.labels)
    labels[a.name] = {'when_to_apply': a.when_to_apply, 'status': 'active'}
    committed('add', [bank.change(labels)], f'label-bank(add): {a.name}', name=a.name)


def update(bank, a):
    entry = bank.entry(a.name)
    lb.refuse_unless_owned(a.name, entry, 'update', protected_too=False)
    if entry['when_to_apply'] == a.when_to_apply:
        print(json.dumps({'status': 'unchanged'}))
        return
    labels = dict(bank.labels, **{a.name: dict(entry, when_to_apply=a.when_to_apply)})
    committed('update', [bank.change(labels)], f'label-bank(update): {a.name}', name=a.name)


def retire(bank, a):
    entry = bank.entry(a.name)
    lb.refuse_unless_owned(a.name, entry, 'retire')
    if entry['status'] == 'retired':
        print(json.dumps({'status': 'unchanged'}))
        return
    labels = dict(bank.labels, **{a.name: dict(entry, status='retired')})
    committed('retire', [bank.change(labels)], f'label-bank(retire): {a.name}', name=a.name)


def rename(bank, a):
    old, new = a.from_, a.to
    entry = bank.entry(old)
    lb.refuse_unless_owned(old, entry, 'rename')
    if new in bank.labels:
        die(f'{new} already exists (status {bank.labels[new]["status"]})')
    labels = {(new if k == old else k): v for k, v in bank.labels.items()}  # same place, same text and status

    def swap(current):
        out = []
        for x in current:
            x = new if x == old else x
            if x not in out:
                out.append(x)
        return out
    notes = lb.carriers(VAULT, old)
    changes = [bank.change(labels)]
    changes += [c for c in (lb.note_change(VAULT, slug, swap) for slug in notes) if c]
    refs = lb.reference_changes(VAULT, old, new)
    changes += refs
    lines = [c.rel for c in changes[1:]]
    message = (f'label-bank(rename): {old} -> {new} — {len(notes)} notes, {len(refs)} reference files\n\n'
               + ''.join(f'- {rel}\n' for rel in lines))
    committed('rename', changes, message, **{'from': old, 'to': new, 'notes': notes,
                                             'references': [c.rel for c in refs]})


def remove(bank, a):
    entry = bank.entry(a.name)
    lb.refuse_unless_owned(a.name, entry, 'remove')
    notes = lb.carriers(VAULT, a.name)
    if notes:
        die(f'{len(notes)} note(s) still carry {a.name}: {", ".join(notes[:10])}'
            + (' …' if len(notes) > 10 else ''))
    refs = lb.referenced_by(VAULT, a.name)
    if refs:
        die(f'{a.name} is still named in {", ".join(refs)}')
    labels = {k: v for k, v in bank.labels.items() if k != a.name}
    committed('remove', [bank.change(labels)], f'label-bank(remove): {a.name}', name=a.name)


def main():
    global VAULT
    p = Parser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='op', required=True, parser_class=Parser)
    for op, fn in (('add', add), ('update', update), ('retire', retire), ('rename', rename), ('remove', remove)):
        s = sub.add_parser(op)
        s.add_argument('vault')
        s.set_defaults(fn=fn)
        if op == 'rename':
            s.add_argument('--from', dest='from_', required=True)
            s.add_argument('--to', required=True)
        else:
            s.add_argument('--name', required=True)
        if op in ('add', 'update'):
            s.add_argument('--when-to-apply', required=True)
    a = p.parse_args()
    VAULT = Path(a.vault).expanduser().resolve()
    try:
        tx.require_vault(VAULT)
        a.fn(lb.Bank(VAULT), a)
    except (lb.BankError, tx.TxError) as e:
        die(e)


VAULT = None

if __name__ == '__main__':
    main()
